#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Upstream's install target assumes a user-local prefix, so the files are
# staged directly under the package root.
override_dh_auto_build:
	$(MAKE) CXX="$(CXX)" \
		CFLAGS="$(CXXFLAGS)" \
		BUILD_CFLAGS="-I/usr/include/lib3mf $(shell pkg-config --cflags cairo)" \
		LDFLAGS="-l3mf -lzip -lz -lcairo $(LDFLAGS)"

override_dh_auto_clean:
	$(MAKE) clean
	rm -rf build-kde

override_dh_auto_test:

override_dh_auto_install:
	install -Dpm 755 3mfthumb $(CURDIR)/debian/3mfthumb/usr/bin/3mfthumb
	install -Dpm 644 3mf.thumbnailer \
		$(CURDIR)/debian/3mfthumb/usr/share/thumbnailers/3mf.thumbnailer
	# The plugin goes into the 3mfthumb-kde package, never the base one.
	cmake -S kde-shellext -B build-kde -DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build-kde
	cmake --install build-kde --prefix $(CURDIR)/debian/3mfthumb-kde/usr

%:
	dh $@
